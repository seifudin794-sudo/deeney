// Personal Task Tracker — simple schema.
// Every query is scoped by the authenticated user's id (RLS-equivalent),
// so each user only sees their own data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  provider     String   @default("credentials")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  categories Category[]
  tasks     Task[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([userId, name])
  @@index([userId])
}

model Task {
  id         String   @id @default(cuid())
  userId     String
  name       String
  categoryId String?
  priority   String   @default("medium") // low | medium | high
  repeatType String   @default("daily")  // daily | every_3_days | weekly
  startDate  String   // YYYY-MM-DD
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subtasks  Subtask[]
  marks     TaskMark[]

  @@index([userId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// One record per (task, due date). Created on demand when a day is viewed or
// marked. Status defaults to "pending"; the auto not-done rule flips pending
// → not_done after the 48-hour grace window.
model TaskMark {
  id         String    @id @default(cuid())
  taskId     String
  userId     String
  dueDate    String    // YYYY-MM-DD — the day this occurrence is due
  status     String    @default("pending") // pending | done | not_done
  reason     String?
  autoMarked Boolean   @default(false)
  markedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dueDate])
  @@index([userId, dueDate])
}
