# ─── DATABASE ───────────────────────────────────────────────
# PostgreSQL connection string.
# For LOCAL DEV: use a local Postgres instance OR a free cloud DB
#   (Supabase / Neon / Vercel Postgres).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
#
# Example (Supabase): postgresql://postgres:pass@db.x.supabase.co:5432/postgres
# Example (Neon):     postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/deeney?schema=public"

# ─── AUTH ────────────────────────────────────────────────────
# No additional secrets needed — sessions are stored in the DB.
# In production on Vercel, set DATABASE_URL in the Vercel dashboard.
